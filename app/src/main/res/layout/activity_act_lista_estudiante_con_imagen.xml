<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/uteq_fondo"
    tools:context=".utils.actListaEstudianteConImagen">

    <LinearLayout
        android:id="@+id/barraInstitucional"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="@color/uteq_verde"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/marca_uteq"
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/marca_descripcion"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:id="@+id/acentoDorado"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:background="@color/uteq_dorado"
        app:layout_constraintTop_toBottomOf="@id/barraInstitucional"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/seccionAcademica"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:text="@string/seccion_academica"
        android:textColor="@color/uteq_verde"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/acentoDorado" />

    <TextView
        android:id="@+id/tituloPantalla"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="4dp"
        android:text="@string/consulta_academica"
        android:textColor="@color/uteq_texto"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/seccionAcademica"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/subtituloPantalla"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/selecciona_semestre"
        android:textColor="@color/uteq_texto_secundario"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@id/tituloPantalla"
        app:layout_constraintEnd_toEndOf="@id/tituloPantalla"
        app:layout_constraintTop_toBottomOf="@id/tituloPantalla" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/semestre"
        app:boxStrokeColor="@color/uteq_dorado"
        app:boxCornerRadiusTopStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusBottomEnd="8dp"
        app:hintTextColor="@color/uteq_verde"
        app:endIconTint="@color/uteq_verde"
        app:layout_constraintStart_toStartOf="@id/tituloPantalla"
        app:layout_constraintEnd_toEndOf="@id/tituloPantalla"
        app:layout_constraintTop_toBottomOf="@id/subtituloPantalla">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/listaNiveles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:textColor="@color/uteq_texto"
            app:simpleItems="@array/niveles" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/materiasLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="@string/materia"
        app:boxStrokeColor="@color/uteq_dorado"
        app:boxCornerRadiusTopStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusBottomEnd="8dp"
        app:hintTextColor="@color/uteq_verde"
        app:endIconTint="@color/uteq_verde"
        app:layout_constraintStart_toStartOf="@id/textInputLayout"
        app:layout_constraintEnd_toEndOf="@id/textInputLayout"
        app:layout_constraintTop_toBottomOf="@id/textInputLayout">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/listaMaterias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:textColor="@color/uteq_texto" />
    </com.google.android.material.textfield.TextInputLayout>

    <ListView
        android:id="@+id/lvAlumnos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/fondo_lista"
        android:clipToOutline="true"
        android:divider="@color/uteq_divisor"
        android:dividerHeight="1dp"
        app:layout_constraintTop_toBottomOf="@id/materiasLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
